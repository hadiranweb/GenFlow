# ---------- Telegram ----------
# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-DEF...

# polling (پیش‌فرض، ساده‌ترین برای VPS) | webhook (نیازمند HTTPS عمومی) | disabled (بدون تلگرام، فقط HTTP)
BOT_MODE=polling

# فقط در حالت webhook لازم است
PUBLIC_BASE_URL=https://example.com
WEBHOOK_SECRET=یک-رشته-تصادفی-بلند
WEBHOOK_PATH=/webhook/telegram

# ---------- HTTP ----------
HTTP_PORT=8080
# برای لینک امضاشدهٔ دانلود گزارش (حتماً در production مقدار تصادفی بگذارید)
REPORT_LINK_SECRET=change-me-to-a-long-random-string

# ---------- Storage ----------
DATA_DIR=./data
DATABASE_PATH=./data/app.db
REPORTS_DIR=./data/reports

# ---------- LLM (فقط برای مرحلهٔ تفسیر ماتریس) ----------
# mock | openai   (openai = هر سرویس سازگار با OpenAI: OpenAI، OpenRouter، Ollama، vLLM …)
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# ---------- Behavior ----------
# لیبل ارزیابی اولیهٔ فرایند اصلی «فیلتر» نیست و مسیر را متوقف نمی‌کند.
# اگر می‌خواهید هنگام صدور لیبل قرمز، به ADMIN_CHAT_ID اطلاع داده شود:
NOTIFY_ADMIN_ON_RED_LABEL=false

# شناسهٔ عددی چت مدیر برای اطلاع‌رسانی‌های اختیاری (مثلاً لیبل قرمز)
# برای گرفتن شناسه: به ربات @userinfobot پیام دهید و chat id خودتان را بردارید.
ADMIN_CHAT_ID=
# سقف زمان پاسخ به هر پرسش (ثانیه) — بعد از آن جلسه رها می‌شود و با /resume ادامه می‌یابد
ANSWER_TIMEOUT_SECONDS=1800
# محدودیت نرخ پیام هر کاربر در دقیقه
RATE_LIMIT_PER_MINUTE=40
LOG_LEVEL=info
